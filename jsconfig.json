{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es6",
    "baseUrl": "src",
    "allowSyntheticDefaultImports": true,
    "jsx": "react",
    "paths": {
      "sass/*": ["./src/assets/scss/*"]
    }
  },
  "include": ["src//*"],
  "exclude": ["node_modules", "build", "dist", ".eslintcache"]
}
